{
  "name": "yow-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "worker:typecheck": "tsc --project tsconfig.worker.json",
    "server:typecheck": "tsc --project tsconfig.server.json",
    "server:start": "node --experimental-strip-types server/ts/local.ts",
    "server:test": "node --experimental-strip-types --test server/ts/tests/*.test.ts",
    "setup:local": "node --experimental-strip-types tools/setup_local.mjs",
    "setup:cloudflare": "node tools/setup_cloudflare.mjs",
    "assets:prepare": "node tools/prepare_assets.mjs",
    "web:build": "vite build --config web/vite.config.ts",
    "web:dev": "vite --config web/vite.config.ts",
    "web:typecheck": "tsc -p web/tsconfig.json",
    "dev": "node --experimental-strip-types tools/dev_server.ts",
    "e2e": "playwright test",
    "e2e:screens": "playwright test e2e/screens.spec.ts",
    "bridge:test": "PYTHONPATH=bridge/src .venv/bin/python -m unittest discover -s bridge/tests -v"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/workers-types": "5.20261026.1",
    "@playwright/test": "1.65.1",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "prettier": "^3.6.2",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "wrangler": "4.152.0"
  },
  "overrides": {
    "undici": "7.30.1"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "echarts": "6.1.0",
    "ws": "^8.22.0"
  },
  "engines": {
    "node": ">=24"
  }
}
