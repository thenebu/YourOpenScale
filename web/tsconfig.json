{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["vite/client"],
    "paths": { "@analysis/*": ["../server/ts/analysis/*"] }
  },
  "include": [
    "src/**/*.ts",
    "../server/ts/analysis/types.ts",
    "../server/ts/analysis/spec.ts",
    "../server/ts/analysis/format.ts"
  ]
}
